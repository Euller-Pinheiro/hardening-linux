# {{ ansible_managed }}
# Gerado pela role hardening. Alterações manuais serão sobrescritas.

[DEFAULT]
backend = systemd
maxretry = {{ hardening_fail2ban_maxretry }}
findtime = {{ hardening_fail2ban_findtime }}
bantime = {{ hardening_fail2ban_bantime }}
bantime.increment = {{ 'true' if hardening_fail2ban_bantime_increment | bool else 'false' }}
bantime.maxtime = {{ hardening_fail2ban_bantime_maxtime }}
ignoreip = {{ (['127.0.0.1/8', '::1'] + hardening_fail2ban_ignoreip) | join(' ') }}

[sshd]
enabled = true
port = {{ hardening_ssh_port }}
# "aggressive" também conta tentativas que nem chegam à senha (usuário
# inexistente, troca de chaves abortada), típicas de robôs de varredura.
mode = aggressive
