// {{ ansible_managed }}
// Ajustes da role hardening sobre o 50unattended-upgrades do pacote.
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if hardening_auto_updates_reboot | bool else 'false' }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ hardening_auto_updates_reboot_time }}";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "{{ 'true' if hardening_auto_updates_remove_unused_kernels | bool else 'false' }}";
Unattended-Upgrade::Remove-Unused-Dependencies "{{ 'true' if hardening_auto_updates_remove_unused_dependencies | bool else 'false' }}";
{% if hardening_auto_updates_mail | length > 0 %}
Unattended-Upgrade::Mail "{{ hardening_auto_updates_mail }}";
Unattended-Upgrade::MailReport "{{ hardening_auto_updates_mail_report }}";
{% endif %}
